void autonomous() {
  // Add auton code here if needed
}

// -----------------------------
// User Control
// -----------------------------
void usercontrol() {

  bool clampState = false;

  while (true) {

    // -----------------------------
    // Tank Drive
    // -----------------------------
    int leftPower = Controller1.Axis3.position();
    int rightPower = Controller1.Axis2.position();

    LeftFront.spin(fwd, leftPower, pct);
    LeftBack.spin(fwd, leftPower, pct);
    RightFront.spin(fwd, rightPower, pct);
    RightBack.spin(fwd, rightPower, pct);

    // -----------------------------
    // Lift Control
    // -----------------------------
    if (Controller1.ButtonR1.pressing()) {
      LiftL.spin(fwd, 90, pct);
      LiftR.spin(fwd, 90, pct);
    }
    else if (Controller1.ButtonR2.pressing()) {
      LiftL.spin(reverse, 90, pct);
      LiftR.spin(reverse, 90, pct);
    }
    else {
      LiftL.stop();  // HOLD
      LiftR.stop();
    }

    // -----------------------------
    // Claw Angle
    // -----------------------------
    if (Controller1.ButtonL1.pressing()) {
      ClawAngle.spin(fwd, 100, pct);
    }
    else if (Controller1.ButtonL2.pressing()) {
      ClawAngle.spin(reverse, 100, pct);
    }
    else {
      ClawAngle.stop();  // HOLD
    }

    // -----------------------------
    // Claw Rotation
    // -----------------------------
    if (Controller1.ButtonUp.pressing()) {
      ClawRotation.spin(fwd, 80, pct);
    }
    else if (Controller1.ButtonDown.pressing()) {
      ClawRotation.spin(reverse, 80, pct);
    }
    else {
      ClawRotation.stop();  // HOLD
    }

    // -----------------------------
    // Piston Toggle
    // -----------------------------
    if (Controller1.ButtonB.pressing()) {
      clampState = !clampState;
      Clamp.set(clampState);
      Controller1.rumble("..");
      wait(300, msec);
    }

    wait(20, msec);
  }
}

// -----------------------------
// Main
// -----------------------------
int main() {
  vexcodeInit();

  Competition.autonomous(autonomous);
  Competition.drivercontrol(usercontrol);

  while (true) {
    wait(100, msec);
  }
}
