using namespace vex;

// Required for competition control
competition Competition;

// Brain
brain Brain;

// Macros
#define waitUntil(condition) do { wait(5, msec); } while (!(condition))
#define repeat(iterations) for (int iterator = 0; iterator < iterations; iterator++)

// -----------------------------
// Robot Configuration
// -----------------------------
controller Controller1;

// Drivetrain motors
motor LeftFront(PORT11, gearSetting::ratio18_1, false);
motor LeftBack(PORT12, gearSetting::ratio18_1, false);
motor RightFront(PORT19, gearSetting::ratio18_1, true);
motor RightBack(PORT20, gearSetting::ratio18_1, true);

// Subsystem motors
motor LiftL(PORT9, gearSetting::ratio18_1, false);
motor LiftR(PORT10, gearSetting::ratio18_1, true);
motor ClawAngle(PORT8, gearSetting::ratio18_1, false);
motor ClawRotation(PORT21, gearSetting::ratio18_1, false);

// Pneumatic clamp
digital_out Clamp(Brain.ThreeWirePort.E);

// Random seed
void initializeRandomSeed() {
  int systemTime = Brain.Timer.systemHighResolution();
  double batteryCurrent = Brain.Battery.current();
  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);
  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;
  srand(seed);
}

void vexcodeInit() {
  initializeRandomSeed();

  // Set stopping modes
  LiftL.setStopping(hold);
  LiftR.setStopping(hold);
  ClawAngle.setStopping(hold);
  ClawRotation.setStopping(hold);

  LeftFront.setStopping(coast);
  LeftBack.setStopping(coast);
  RightFront.setStopping(coast);
  RightBack.setStopping(coast);
}

void playVexcodeSound(const char *soundName) {
  printf("VEXPlaySound:%s\n", soundName);
  wait(5, msec);
}

