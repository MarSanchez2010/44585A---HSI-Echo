void SoloAWP() {

  // Assumes:
// const int DRIVE_SPEED = 60;
// const int TURN_SPEED  = 50;
//
// extern ez::Drive chassis;
// extern pros::Motor IntakeStage1, IntakeStage2, IntakeStage3;
// extern ez::Piston Descore, Matchload;

  // Descore on
  Descore.set(true);

  // ---------------------------
  // FIRST TURNS + ALIGN
  // ---------------------------
  chassis.pid_drive_set(22_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // left 20 deg
  chassis.pid_turn_set(-20_deg, TURN_SPEED);
  chassis.pid_wait();
  stage1.move(-127); // reverse

  pros::delay(10);

  // intake + slow drive
  stage1.move(-127); // reverse
  stage2.move(127);
  chassis.pid_drive_set(16_in, 30, true);
  chassis.pid_wait();

  pros::delay(50);
  stage2.move(127);
  pros::delay(1000);

  stage1.move(0);
  stage2.move(0);

  chassis.pid_drive_set(-4_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // ---------------------------
  // LINE UP WITH GOAL
  // ---------------------------
  // left 110 deg
  chassis.pid_turn_set(-150_deg, TURN_SPEED);
  chassis.pid_wait();

  chassis.pid_drive_set(-16_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  stage3.move(127);
  pros::delay(1000);
  stage3.move(0);

  stage1.move(-127);
  stage2.move(127);

  chassis.pid_drive_set(45_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // right 45 deg (negative angle if your convention is CCW positive)
  chassis.pid_turn_set(-90_deg, TURN_SPEED);
  chassis.pid_wait();


  // drive in front of the goal
  chassis.pid_drive_set(15_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // Turn towards the goal
  chassis.pid_turn_set(180_deg, TURN_SPEED);
  chassis.pid_wait();
  //back into the goal
  chassis.pid_drive_set(-23_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // ---------------------------
  // SCORE SEQUENCE
  // ---------------------------
  stage1.move(127);
  stage2.move(127);
  stage3.move(127);
  pros::delay(2000);

  stage1.move(0);
  stage2.move(0);
  stage3.move(0);

  Descore.set(false);

  // ---------------------------
  // FINAL MOVES
  // ---------------------------
  chassis.pid_drive_set(16_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // right 70 deg
  chassis.pid_turn_set(120_deg, TURN_SPEED);
  chassis.pid_wait();

  chassis.pid_drive_set(-12_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  // left 80 deg
  chassis.pid_turn_set(180_deg, TURN_SPEED);
  chassis.pid_wait();

  chassis.pid_drive_set(-26_in, DRIVE_SPEED, true);
  chassis.pid_wait();

  Matchloader.set(true);
}

